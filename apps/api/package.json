    "puppeteer": "25.5.0",
    "testcontainers": "12.1.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-node": "8.0.0",
    "vitest": "4.1.10"
