    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@at/document-templates": "workspace:*",
    "@at/dynamic-markdown": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.1",
    "@fastify/otel": "0.20.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@repo/shared-types": "workspace:^",
    "dotenv": "17.4.2",
    "fastify": "5.11.3",
    "fastify-type-provider-zod": "7.0.0",
    "jwks-rsa": "4.1.0",
    "marked": "18.0.9",
    "pdf-lib": "1.17.1",
    "pino-pretty": "13.1.3",
