{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "tsdown server.ts",
    "test": "vitest run --coverage lib",
    "test:integration": "vitest run integration-tests",
    "test:load": "pnpm dlx --allow-build=esbuild tsx load-tests/run.ts",
    "test:burst": "pnpm dlx --allow-build=esbuild tsx load-tests/burst.ts",
    "test:load:analyze": "pnpm dlx --allow-build=esbuild tsx load-tests/analyze.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@at/document-templates": "workspace:*",
    "@at/dynamic-markdown": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/otel": "0.21.3",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@opentelemetry/api": "1.10.0",
    "@repo/shared-types": "workspace:^",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jwks-rsa": "4.1.0",
    "marked": "18.1.1",
    "pdf-lib": "1.17.1",
    "pino-pretty": "13.2.0",
    "puppeteer-core": "25.16.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "pdf-text-reader": "5.1.1",
    "pdf-visual-diff": "0.16.0",
    "puppeteer": "25.16.0",
    "testcontainers": "12.2.1",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-node": "8.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26"
  }
}
