{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>Arbeidstilsynet/renovate-config", "customManagers:dockerfileVersions"],
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchFileNames": ["apps/preview-web/package.json", "apps/api/package.json"],
      "extends": ["config:js-app"]
    },
    {
      "matchDatasources": ["repology"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "description": "Repology provides no release timestamps"
    },
    {
      "matchDatasources": ["repology"],
      "matchPackageNames": ["debian_13/chromium"],
      "groupName": "chromium",
      "separateMajorMinor": false,
      "automerge": true,
      "description": "Group Chromium updates with Puppeteer for compatibility (https://pptr.dev/supported-browsers)"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["puppeteer", "puppeteer-core"],
      "groupName": "chromium",
      "separateMajorMinor": false,
      "automerge": true,
      "description": "Group Chromium updates with Puppeteer for compatibility (https://pptr.dev/supported-browsers)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["apps/api/package.json"],
      "matchPackageNames": ["@opentelemetry/api"],
      "allowedVersions": "<1.10.0",
      "description": "Must not exceed the @opentelemetry/api version in the Nais-injected Node.js auto-instrumentation (currently 0.78.0 with api 1.9.1). A newer minor rejects the injected global SDK and silently no-ops all metrics and spans."
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["digest"],
      "groupName": "node.js digests",
      "description": "group different node image tags"
    }
  ]
}
