{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>Arbeidstilsynet/renovate-config", "customManagers:dockerfileVersions"],
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchFileNames": ["apps/preview-web/package.json", "apps/api/package.json"],
      "extends": ["config:js-app"]
    },
    {
      "matchDatasources": ["repology"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "description": "Repology provides no release timestamps"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["digest"],
      "groupName": "node.js digests",
      "description": "group different node image tags"
    },
    {
      "matchManagers": ["nuget"],
      "matchFileNames": ["nuget-client/**"],
      "matchPackageNames": ["Microsoft.Extensions.*"],
      "allowedVersions": "<11",
      "description": "The client targets net10.0 (LTS); keep the lowest supported Microsoft.Extensions major so consumers are not forced onto a newer one"
    }
  ]
}
