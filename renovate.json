{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>Arbeidstilsynet/renovate-config"],
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchFileNames": ["apps/preview-web/package.json", "apps/api/package.json"],
      "extends": ["config:js-app"]
    },
    {
      "matchDatasources": ["repology"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "description": "Repology provides no release timestamps"
    },
    {
      "matchDatasources": ["repology"],
      "matchPackageNames": ["debian_13/chromium"],
      "groupName": "chromium",
      "description": "Group Chromium updates with Puppeteer for compatibility (https://pptr.dev/supported-browsers)"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["puppeteer", "puppeteer-core"],
      "automerge": false,
      "groupName": "chromium",
      "description": "Avoid automerging puppeteer patches to preserve compatibility with specific Chromium versions"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["digest"],
      "groupName": "node.js digests",
      "description": "group different node image tags"
    }
  ]
}
